# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA coloque valores reais neste arquivo (.env.example) nem no Git.
# O passo a passo completo de cada serviço está no README.md.

# --- App -------------------------------------------------------------
# Endereço público do site (usado em e-mails, links de ficha, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Fase 0/3) ----------------------------------------------
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — segredo, só é usada no servidor (nunca no navegador)
SUPABASE_SERVICE_ROLE_KEY=

# --- Asaas — pagamentos e assinaturas (Fase 3) ------------------------
# Comece pelo ambiente sandbox (teste) antes de ir para produção
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token que você mesmo cria e configura no Asaas para validar o webhook
ASAAS_WEBHOOK_SECRET=

# --- Resend — envio de e-mails (Fase 3) --------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="ATLAS NOVA ERA <contato@SEUDOMINIO.com.br>"

# --- Cron (Vercel Cron) — protege as rotas agendadas (Fase 5) ---------
CRON_SECRET=

# --- Plano Vitalício (Fase 2/3) -----------------------------------------
# Quantas vagas existem no total. Deixe em branco para NÃO mostrar a
# contagem de vagas restantes no site (nunca inventamos esse número).
LIFETIME_SEATS_TOTAL=

# --- Painel do dono da plataforma (Fase 3) -----------------------------
# E-mails com acesso ao painel de administração da plataforma (separados por vírgula)
SUPER_ADMIN_EMAILS=

# --- Cloudflare Turnstile — anti-robô na ficha de cadastro (Fase 4) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- WhatsApp (Fase 5) --------------------------------------------------
# Definido junto com você na Fase 5 (API oficial da Meta ou QR code)
# WHATSAPP_PROVIDER=

# --- IA — sugestão de resposta, opcional (Fase 8) -----------------------
# Chave usada apenas no servidor, nunca exposta ao navegador
# ANTHROPIC_API_KEY=
